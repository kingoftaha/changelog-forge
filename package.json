{
  "name": "changelog-forge",
  "version": "1.0.0",
  "description": "A tool that generates a polished CHANGELOG.md from git log and Conventional Commits.",
  "main": "src/changelog-forge.js",
  "type": "commonjs",
  "bin": {
    "changelog-forge": "src/changelog-forge.js"
  },
  "scripts": {
    "start": "node src/changelog-forge.js",
    "test": "node --test test/ || echo 'no tests yet \u2014 add some in test/'",
    "tracker": "node src/achievement-tracker.js",
    "roadmap": "node src/achievement-tracker.js --roadmap",
    "setup": "bash scripts/setup.sh"
  },
  "keywords": [
    "changelog",
    "conventional-commits",
    "git",
    "cli",
    "release-notes"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/changelog-forge.git"
  },
  "author": ""
}
